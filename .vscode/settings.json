{
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.rulers": [80],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.compilerPath": "/usr/bin/gcc",
  "C_Cpp.clang_format_fallbackStyle": "file",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "/usr/include",
    "/usr/include/SDL2",
    "/usr/local/include"
  ],

  /* Deshabilitar tareas automáticas de C/C++ */
  "C_Cpp.default.browse.path": [
    "${workspaceFolder}/**",
    "/usr/include",
    "/usr/include/SDL2",
    "/usr/local/include"
  ],

  /* Configurar comando de build para Code Runner (si está instalado) */
  "code-runner.executorMap": {
    "c": "cd $dir && make && $dir$fileNameWithoutExt"
  },
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,

  /* Evitar que C/C++ genere tareas automáticas */
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json"
}
